{
  "proxmox": {
    "secrets": [
      {
        "var": "PM_API_TOKEN_SECRET",
        "source": "pass",
        "key": "fog/proxmox/api_token_secret"
      },
      {
        "var": "PM_API_TOKEN_ID",
        "source": "pass",
        "key": "fog/proxmox/api_token_id"
      }
    ],
    "composites": [
      {
        "var": "PROXMOX_VE_API_TOKEN",
        "template": "${PM_API_TOKEN_ID}=${PM_API_TOKEN_SECRET}"
      }
    ]
  },
  "omni": {
    "secrets": [
      {
        "var": "OMNI_SERVICE_ACCOUNT_KEY",
        "source": "pass",
        "key": "fog/omni/service_account_key"
      }
    ]
  },
  "vault": {
    "secrets": [
      {
        "var": "VAULT_TOKEN",
        "source": "pass",
        "key": "fog/vault/root_token"
      }
    ]
  },
  "pihole": {
    "secrets": [
      {
        "var": "PIHOLE_PASSWORD",
        "source": "pass",
        "key": "lodge/heihei/pihole-app"
      }
    ]
  },
  "litellm": {
    "secrets": [
      {
        "var": "LITELLM_MASTER_KEY",
        "source": "vault",
        "key": "secret/app/litellm",
        "field": "master_key"
      },
      {
        "var": "LITELLM_WORKER_KEY",
        "source": "vault",
        "key": "secret/app/litellm",
        "field": "worker_key"
      }
    ]
  },
  "runpod": {
    "secrets": [
      {
        "var": "RUNPOD_API_KEY",
        "source": "pass",
        "key": "fog/runpod/api_key"
      }
    ]
  },
  "gc": {
    "secrets": [
      {
        "var": "DOLT_PASSWORD",
        "source": "pass",
        "key": "fog/gascity/dolt/password"
      }
    ],
    "composites": [
      {
        "var": "DOLT_HOST",
        "template": "dolt.fog.chalko.com"
      },
      {
        "var": "DOLT_PORT",
        "template": "3306"
      },
      {
        "var": "DOLT_USER",
        "template": "gascity"
      },
      {
        "var": "DOLT_DATABASE",
        "template": "hq"
      },
      {
        "var": "BEADS_DOLT_HOST",
        "template": "dolt.fog.chalko.com"
      },
      {
        "var": "BEADS_DOLT_PORT",
        "template": "3306"
      },
      {
        "var": "BEADS_DOLT_USER",
        "template": "gascity"
      },
      {
        "var": "BEADS_DOLT_DATABASE",
        "template": "hq"
      },
      {
        "var": "BEADS_DOLT_PASSWORD",
        "template": "${DOLT_PASSWORD}"
      }
    ]
  }
}

