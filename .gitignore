# Local environment secrets caching directory (handled in /dev/shm, but just in case)
*.env
.env*
!config.env
!.env.example
!*.env.example

# IDEs
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Terraform / OpenTofu
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
*.tfvars
*.tfvars.json
.terraform.lock.hcl

# Local binaries
bin/talosctl

# Talos local configs / secrets
controlplane.yaml
worker.yaml
talosconfig
kubeconfig

# Python compilation artifacts
__pycache__/
*.pyc

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Gas City & Agent Runtime
.beads/*
!.beads/config.yaml
!.beads/metadata.json
!.beads/identity.toml
!.beads/README.md
!.beads/.gitignore
!.beads/formulas/
.beads/formulas/*
!.beads/formulas/fog-gitops.formula.toml
.gc/
.agents/*
!.agents/skills/
.agents/skills/core.*
.agents/skills/gc.*
.agents/skills/.*
.opencode/
.claude/
.codex/



