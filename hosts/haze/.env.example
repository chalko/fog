# ==============================================================================
# Haze (ASUS Ascent GX10) - Environment Configuration Example
# ==============================================================================
# Copy this file to .env on haze and populate with credentials.
# Secrets should be synchronized from Vault (secret/fog/haze/vllm).

# Hugging Face User Access Token (Required for gated model downloads)
HF_TOKEN=hf_your_token_here

# Local cache directory for Hugging Face models and weights
HF_CACHE_DIR=/var/cache/huggingface

# vLLM API Host Port
VLLM_PORT=8000
